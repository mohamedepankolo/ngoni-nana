# Copier en ".env" (déjà ignoré par Git) et remplir. Ne jamais commiter de vraies valeurs.

# Jeton exigé sur tous les endpoints de l'API sauf /health (moteur/api.py).
API_TOKEN=change-moi

# Jeton Hugging Face : nécessaire pour le TTS (MALIBA-AI/MalianTTS, Space
# Gradio) et pour certains modèles ASR à accès restreint.
HF_TOKEN=

# Connexion base de données. Par défaut : fichier SQLite local (rien à
# configurer). En production, pointer vers Postgres/Neon (R1 non tranché) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote/base
DATABASE_URL=sqlite:///ngoni_nana.db
